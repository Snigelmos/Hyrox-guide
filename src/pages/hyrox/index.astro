---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Hyrox by Country — Germany and Switzerland Race Hubs";
const description = "Country hubs for the markets that search in their own language: the full Hyrox Germany 2026 and Hyrox Switzerland 2026 calendars, plus explainers for the cities that dropped off the schedule.";

const breadcrumbs = [{ name: "Hyrox cities" }];
---

<BaseLayout
  title={`${title} | Hyrox Vault`}
  description={description}
  ogType="article"
  schemaType="Article"
  breadcrumbs={breadcrumbs}
>
  <div class="container-main py-10 md:py-16">
    <header class="mb-10 pb-8 border-b border-border max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-black leading-tight text-gradient-accent">
        Hyrox by country
      </h1>
      <p class="mt-4 text-lg text-text-muted leading-relaxed">{description}</p>
    </header>

    <section class="prose md:prose-lg max-w-none mb-10 max-w-3xl">
      <p>
        Country hubs cover the whole national calendar in one place, including the local-language search terms and the cities that aren't on this season's schedule. For a specific race city, the <a href="/events/2026/">2026 event calendar</a> has the venue, dates, course notes, and race-day detail for every stop.
      </p>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl md:text-3xl font-black text-text-heading mb-4">Country hubs</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <a
          href="/hyrox/germany/"
          class="block bg-bg-card border border-border rounded-2xl p-6 hover:border-accent/40 hover:bg-bg-card-hover transition-all no-underline"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-accent mb-2">Country · Deutschland</div>
          <div class="text-2xl font-black text-text-heading mb-2">Hyrox Germany 2026</div>
          <p class="text-sm text-text-muted leading-relaxed">Full German Hyrox calendar plus a Hyrox München 2026 explainer for athletes whose home race isn't on the calendar.</p>
        </a>
        <a
          href="/hyrox/switzerland/"
          class="block bg-bg-card border border-border rounded-2xl p-6 hover:border-accent/40 hover:bg-bg-card-hover transition-all no-underline"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-accent mb-2">Country · Schweiz · Svizzera</div>
          <div class="text-2xl font-black text-text-heading mb-2">Hyrox Switzerland 2026</div>
          <p class="text-sm text-text-muted leading-relaxed">St Gallen and Geneva on the 2026 calendar. Hyrox Zürich 2026 explainer for Zurich-based athletes.</p>
        </a>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl md:text-3xl font-black text-text-heading mb-4">Looking for a race city?</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <a
          href="/events/2026/"
          class="block bg-bg-card border border-border rounded-2xl p-6 hover:border-accent/40 hover:bg-bg-card-hover transition-all no-underline"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-accent mb-2">Calendar</div>
          <div class="text-xl font-black text-text-heading mb-2">Every Hyrox 2026 race by date</div>
          <p class="text-sm text-text-muted leading-relaxed">Dates, venues, and course notes for every stop on the season, plus race reports for the ones already run.</p>
        </a>
        <a
          href="/gyms/map/"
          class="block bg-bg-card border border-border rounded-2xl p-6 hover:border-accent/40 hover:bg-bg-card-hover transition-all no-underline"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-accent mb-2">Gym finder</div>
          <div class="text-xl font-black text-text-heading mb-2">Hyrox gyms near your city</div>
          <p class="text-sm text-text-muted leading-relaxed">Verified Hyrox-affiliated training clubs worldwide on one searchable map.</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
